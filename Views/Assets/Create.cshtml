@model InventoryManagementSystem.Models.ViewModels.AssetViewModel
@{
    ViewData["Title"] = "Add New Asset";
}

<div class="mb-4">
    <a href="@Url.Action("Index", "Assets")" class="btn btn-outline-secondary btn-sm mb-2">
        <i class="bi bi-arrow-left me-1"></i> Back to Assets List
    </a>
    <h4 class="fw-bold mb-1">Add New Inventory Asset</h4>
    <p class="text-muted small mb-0">Enter details to add a new physical or digital asset to the inventory.</p>
</div>

<div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-4" role="alert"></div>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label asp-for="AssetCode" class="form-label fw-semibold text-dark"></label>
                    <input asp-for="AssetCode" class="form-control" placeholder="e.g. AST-LAP-099" required />
                    <span asp-validation-for="AssetCode" class="text-danger small"></span>
                </div>

                <div class="col-md-5">
                    <label asp-for="AssetName" class="form-label fw-semibold text-dark"></label>
                    <input asp-for="AssetName" class="form-control" placeholder="e.g. Dell XPS 15 Laptop" required />
                    <span asp-validation-for="AssetName" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="CategoryId" class="form-label fw-semibold text-dark"></label>
                    <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select" required>
                        <option value="">-- Select Category --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label asp-for="SerialNumber" class="form-label fw-semibold text-dark"></label>
                    <input asp-for="SerialNumber" class="form-control" placeholder="Manufacturer Serial Number" />
                    <span asp-validation-for="SerialNumber" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="PurchaseDate" class="form-label fw-semibold text-dark"></label>
                    <input asp-for="PurchaseDate" type="date" class="form-control" required />
                    <span asp-validation-for="PurchaseDate" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="PurchaseCost" class="form-label fw-semibold text-dark"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light">$</span>
                        <input asp-for="PurchaseCost" type="number" step="0.01" class="form-control" placeholder="0.00" required />
                    </div>
                    <span asp-validation-for="PurchaseCost" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label asp-for="Status" class="form-label fw-semibold text-dark"></label>
                    <select asp-for="Status" asp-items="Model.Statuses" class="form-select" required></select>
                    <span asp-validation-for="Status" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Location" class="form-label fw-semibold text-dark"></label>
                    <input asp-for="Location" class="form-control" placeholder="e.g. Building A - Floor 3" />
                    <span asp-validation-for="Location" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Department" class="form-label fw-semibold text-dark"></label>
                    <input asp-for="Department" class="form-control" placeholder="e.g. IT Operations" />
                    <span asp-validation-for="Department" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="AssignedToUserId" class="form-label fw-semibold text-dark"></label>
                    <select asp-for="AssignedToUserId" asp-items="Model.Users" class="form-select">
                        <option value="">-- Unassigned (Available in Stock) --</option>
                    </select>
                    <small class="form-text text-muted d-block">Only active users are listed for assignment.</small>
                    <span asp-validation-for="AssignedToUserId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Description" class="form-label fw-semibold text-dark"></label>
                    <textarea asp-for="Description" class="form-control" rows="2" placeholder="Specifications, warranty info, condition details..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
            </div>

            <hr class="my-4">

            <div class="d-flex align-items-center justify-content-end gap-2">
                <a href="@Url.Action("Index", "Assets")" class="btn btn-light px-4">Cancel</a>
                <button type="submit" class="btn btn-primary px-4 shadow-sm">
                    <i class="bi bi-check-lg me-1"></i> Save Asset
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
