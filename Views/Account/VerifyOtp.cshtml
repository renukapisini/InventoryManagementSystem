@model InventoryManagementSystem.Models.ViewModels.VerifyOtpViewModel
@{
    Layout = null;
    ViewData["Title"] = "Email OTP Verification";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Email OTP Verification - IMS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #0f172a 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }
        .otp-card {
            width: 100%;
            max-width: 450px;
            background: rgba(255, 255, 255, 0.96);
            backdrop-filter: blur(10px);
            border-radius: 16px;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
        }
        .otp-input {
            letter-spacing: 0.5rem;
            font-size: 1.5rem;
            font-weight: 700;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="otp-card p-4 p-md-5">
        <div class="text-center mb-4">
            <div class="bg-primary-soft text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                <i class="bi bi-shield-lock fs-2"></i>
            </div>
            <h4 class="font-weight-bold mb-1 text-dark">Email Verification</h4>
            <p class="text-muted small">We sent a 6-digit OTP code to<br><strong class="text-dark">@Model.Email</strong></p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-info small p-2 mb-3" role="alert">
                <i class="bi bi-info-circle me-1"></i> @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger small p-2 mb-3" role="alert">
                <i class="bi bi-exclamation-triangle me-1"></i> @TempData["ErrorMessage"]
            </div>
        }

        <form asp-action="VerifyOtp" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Purpose" />

            <div class="mb-4 text-center">
                <label asp-for="OtpCode" class="form-label font-weight-semibold text-dark small"></label>
                <input asp-for="OtpCode" class="form-control otp-input py-2" placeholder="••••••" maxlength="6" autofocus required />
                <span asp-validation-for="OtpCode" class="text-danger small d-block mt-1"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 shadow-sm font-weight-semibold mb-3">
                <i class="bi bi-check2-circle me-1"></i> Verify OTP Code
            </button>
        </form>

        <div class="text-center mt-3 pt-3 border-top">
            <small class="text-muted d-block mb-2">Didn't receive the code?</small>
            <form asp-action="ResendOtp" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="email" value="@Model.Email" />
                <input type="hidden" name="purpose" value="@Model.Purpose" />
                <button type="submit" id="resendBtn" class="btn btn-sm btn-link text-primary text-decoration-none fw-semibold">
                    <i class="bi bi-arrow-counterclockwise"></i> Resend OTP Code
                </button>
            </form>
        </div>
    </div>
</body>
</html>
