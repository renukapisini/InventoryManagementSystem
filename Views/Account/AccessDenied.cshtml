@{
    ViewData["Title"] = "Access Denied";
}
<div class="row justify-content-center py-5">
    <div class="col-md-8 col-lg-6 text-center">
        <div class="card shadow-sm border-0 rounded-4 p-4 p-md-5">
            <div class="mb-4 text-danger">
                <i class="bi bi-shield-x display-1"></i>
            </div>
            <h2 class="fw-bold text-dark mb-2">Access Denied (403)</h2>
            <p class="text-muted mb-4">
                You do not have administrative permission to view or access this module. If you believe this is an error, please contact your Asset Manager.
            </p>
            <div>
                <a href="@Url.Action("Index", "Dashboard")" class="btn btn-primary px-4 py-2">
                    <i class="bi bi-arrow-left me-2"></i> Return to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
