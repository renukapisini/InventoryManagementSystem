@model InventoryManagementSystem.Models.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Sign In";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In - Inventory Management System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #0f172a 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-card {
            width: 100%;
            max-width: 440px;
            background: rgba(255, 255, 255, 0.96);
            backdrop-filter: blur(10px);
            border-radius: 16px;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 10px 10px -5px rgba(0, 0, 0, 0.2);
        }
    </style>
</head>
<body>
    <div class="p-3">
        <div class="login-card p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="bg-primary text-white rounded-3 d-inline-flex align-items-center justify-content-center mb-3 shadow" style="width: 56px; height: 56px;">
                    <i class="bi bi-box-seam fs-2"></i>
                </div>
                <h4 class="font-weight-bold mb-1 text-dark">IMS Portal</h4>
                <p class="text-muted small">Inventory Management System</p>
            </div>

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger small p-2 mb-3" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="UsernameOrEmail" class="form-label font-weight-medium small text-dark"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted"><i class="bi bi-person"></i></span>
                        <input asp-for="UsernameOrEmail" id="usernameInput" class="form-control" placeholder="e.g. manager@ims.com or manager" required />
                    </div>
                    <span asp-validation-for="UsernameOrEmail" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label font-weight-medium small text-dark"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted"><i class="bi bi-lock"></i></span>
                        <input asp-for="Password" id="passwordInput" class="form-control" placeholder="••••••••" required />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="d-flex align-items-center justify-content-between mb-4">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label small text-muted"></label>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 mb-3 shadow-sm font-weight-semibold">
                    <i class="bi bi-box-arrow-in-right me-2"></i> Sign In
                </button>
            </form>

            <hr class="my-4 text-muted">

            <!-- Quick Demo Login Helpers -->
            <div class="bg-light p-3 rounded-3 border">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="fw-bold text-uppercase text-secondary" style="font-size:0.7rem; letter-spacing:0.05em;">Quick Demo Credentials</span>
                    <span class="badge bg-success-soft" style="font-size:0.65rem;">Auto-Seeded</span>
                </div>
                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-sm btn-outline-primary text-start d-flex align-items-center justify-content-between" onclick="fillDemo('manager@ims.com', 'Password123!')">
                        <div>
                            <strong class="d-block text-dark">Asset Manager</strong>
                            <small class="text-muted">manager@ims.com</small>
                        </div>
                        <i class="bi bi-arrow-right-short fs-4"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary text-start d-flex align-items-center justify-content-between" onclick="fillDemo('executive@ims.com', 'Password123!')">
                        <div>
                            <strong class="d-block text-dark">Inventory Executive</strong>
                            <small class="text-muted">executive@ims.com</small>
                        </div>
                        <i class="bi bi-arrow-right-short fs-4"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        function fillDemo(username, password) {
            document.getElementById('usernameInput').value = username;
            document.getElementById('passwordInput').value = password;
        }
    </script>
</body>
</html>
