@model InventoryManagementSystem.Models.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="mb-4">
    <a href="@Url.Action("Index", "Profile")" class="btn btn-outline-secondary btn-sm mb-2">
        <i class="bi bi-arrow-left me-1"></i> Back to Profile
    </a>
    <h4 class="fw-bold mb-1">Change Account Password</h4>
    <p class="text-muted small mb-0">Update your login security credentials.</p>
</div>

<div class="card shadow-sm border-0 rounded-4 col-md-6">
    <div class="card-body p-4">
        <form asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label fw-semibold text-dark"></label>
                <input asp-for="CurrentPassword" class="form-control" required />
                <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label fw-semibold text-dark"></label>
                <input asp-for="NewPassword" class="form-control" required />
                <small class="form-text text-muted">Min 8 chars: at least 1 uppercase, 1 lowercase, 1 digit, 1 special char.</small>
                <span asp-validation-for="NewPassword" class="text-danger small d-block"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label fw-semibold text-dark"></label>
                <input asp-for="ConfirmPassword" class="form-control" required />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <div class="d-flex align-items-center justify-content-end gap-2">
                <a href="@Url.Action("Index", "Profile")" class="btn btn-light px-4">Cancel</a>
                <button type="submit" class="btn btn-primary px-4 shadow-sm">Update Password</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
