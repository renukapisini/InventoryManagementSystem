@model InventoryManagementSystem.Models.ViewModels.UserViewModel
@{
    ViewData["Title"] = "Edit User";
}

<div class="mb-4">
    <a href="@Url.Action("Details", "Users", new { id = Model.Id })" class="btn btn-outline-secondary btn-sm mb-2">
        <i class="bi bi-arrow-left me-1"></i> Back to User Details
    </a>
    <h4 class="fw-bold mb-1">Edit User: @Model.FirstName @Model.LastName</h4>
</div>

<div class="card shadow-sm border-0 rounded-4 col-lg-10">
    <div class="card-body p-4">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-4"></div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label asp-for="EmployeeId" class="form-label fw-semibold text-dark"></label>
                    <input asp-for="EmployeeId" class="form-control" required />
                    <span asp-validation-for="EmployeeId" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="FirstName" class="form-label fw-semibold text-dark"></label>
                    <input asp-for="FirstName" class="form-control" required />
                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="LastName" class="form-label fw-semibold text-dark"></label>
                    <input asp-for="LastName" class="form-control" required />
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-semibold text-dark"></label>
                    <input asp-for="Email" class="form-control" required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="MobileNumber" class="form-label fw-semibold text-dark"></label>
                    <input asp-for="MobileNumber" class="form-control" />
                    <span asp-validation-for="MobileNumber" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label asp-for="Username" class="form-label fw-semibold text-dark"></label>
                    <input asp-for="Username" class="form-control" required />
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Password" class="form-label fw-semibold text-dark">New Password (Optional)</label>
                    <input asp-for="Password" class="form-control" placeholder="Leave blank to keep existing" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="RoleId" class="form-label fw-semibold text-dark"></label>
                    <select asp-for="RoleId" asp-items="Model.Roles" class="form-select" required></select>
                    <span asp-validation-for="RoleId" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="Department" class="form-label fw-semibold text-dark"></label>
                    <input asp-for="Department" class="form-control" />
                    <span asp-validation-for="Department" class="text-danger small"></span>
                </div>

                <div class="col-md-6 d-flex align-items-center mt-4">
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label fw-semibold text-dark"></label>
                    </div>
                </div>
            </div>

            <hr class="my-4">

            <div class="d-flex align-items-center justify-content-end gap-2">
                <a href="@Url.Action("Details", "Users", new { id = Model.Id })" class="btn btn-light px-4">Cancel</a>
                <button type="submit" class="btn btn-primary px-4 shadow-sm">Update User</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
