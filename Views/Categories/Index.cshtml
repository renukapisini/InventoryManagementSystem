@model List<InventoryManagementSystem.Models.ViewModels.CategoryViewModel>
@{
    ViewData["Title"] = "Category Management";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-1">Asset Categories</h4>
        <p class="text-muted small mb-0">Create and manage equipment classifications.</p>
    </div>
    <a href="@Url.Action("Create", "Categories")" class="btn btn-primary btn-sm shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Add Category
    </a>
</div>

<div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table custom-table mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Category Name</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th>Linked Assets</th>
                        <th>Created Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var cat in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@cat.Name</td>
                                <td class="text-muted small">@(string.IsNullOrEmpty(cat.Description) ? "No description" : cat.Description)</td>
                                <td>
                                    @if (cat.IsActive)
                                    {
                                        <span class="badge bg-success-soft text-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-soft text-secondary">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-light text-primary border">@cat.AssetCount Assets</span>
                                </td>
                                <td class="text-muted small">@cat.CreatedDate.ToString("MMM dd, yyyy")</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a href="@Url.Action("Edit", "Categories", new { id = cat.Id })" class="btn btn-light text-secondary" title="Edit Category">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="ToggleStatus" asp-route-id="@cat.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-light @(cat.IsActive ? "text-warning" : "text-success")" title="@(cat.IsActive ? "Deactivate" : "Activate")">
                                                <i class="bi @(cat.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                            </button>
                                        </form>
                                        <button type="button" class="btn btn-light text-danger" data-bs-toggle="modal" data-bs-target="#deleteCatModal-@cat.Id" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>

                                    <!-- Delete Category Modal -->
                                    <div class="modal fade text-start" id="deleteCatModal-@cat.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header border-0">
                                                    <h6 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle text-danger me-2"></i> Confirm Delete Category</h6>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body text-muted">
                                                    @if (cat.AssetCount > 0)
                                                    {
                                                        <div class="alert alert-warning small mb-0">
                                                            <i class="bi bi-exclamation-circle me-1"></i> Cannot delete <strong>@cat.Name</strong> because it has <strong>@cat.AssetCount</strong> linked assets.
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span>Are you sure you want to delete category <strong>@cat.Name</strong>?</span>
                                                    }
                                                </div>
                                                <div class="modal-footer border-0">
                                                    <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                    @if (cat.AssetCount == 0)
                                                    {
                                                        <form asp-action="Delete" asp-route-id="@cat.Id" method="post">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                                        </form>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No categories available.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
