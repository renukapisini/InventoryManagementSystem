@model InventoryManagementSystem.Models.ViewModels.OrganizationViewModel
@{
    ViewData["Title"] = "Organisation Profile";
}

<div class="mb-4 d-flex align-items-center justify-content-between">
    <div>
        <h4 class="fw-bold mb-1">Organisation Profile</h4>
        <p class="text-muted small mb-0">Manage enterprise metadata, branding, and logo imagery.</p>
    </div>
    <a href="@Url.Action("Edit", "Organization")" class="btn btn-primary btn-sm shadow-sm">
        <i class="bi bi-pencil me-1"></i> Edit Profile
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 rounded-4 text-center p-4">
            <div class="mb-3">
                <img src="@(string.IsNullOrEmpty(Model.LogoPath) ? "/images/default-logo.svg" : Model.LogoPath)" alt="Org Logo" class="img-fluid rounded-3 shadow-sm border p-2 bg-white" style="max-height: 120px;" />
            </div>
            <h5 class="fw-bold text-dark mb-1">@Model.OrganisationName</h5>
            <span class="badge bg-secondary font-monospace mb-3">@Model.OrganisationCode</span>

            <div class="border-top pt-3 text-start small text-muted">
                <div class="mb-2"><i class="bi bi-globe me-2 text-primary"></i><a href="@Model.Website" target="_blank" class="text-decoration-none">@(Model.Website ?? "No website")</a></div>
                <div class="mb-2"><i class="bi bi-envelope me-2 text-danger"></i>@(Model.Email ?? "No email")</div>
                <div><i class="bi bi-telephone me-2 text-success"></i>@(Model.Phone ?? "No phone")</div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-white border-0 py-3">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-building me-2 text-primary"></i> Company Details</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <small class="text-muted d-block fw-semibold text-uppercase" style="font-size:0.75rem;">Address</small>
                        <span class="fs-6 text-dark">@(Model.Address ?? "N/A")</span>
                    </div>

                    <div class="col-md-6">
                        <small class="text-muted d-block fw-semibold text-uppercase" style="font-size:0.75rem;">City & State</small>
                        <span class="fs-6 text-dark">@Model.City, @Model.State</span>
                    </div>

                    <div class="col-md-6">
                        <small class="text-muted d-block fw-semibold text-uppercase" style="font-size:0.75rem;">Country & Postal Code</small>
                        <span class="fs-6 text-dark">@Model.Country @Model.PostalCode</span>
                    </div>

                    <div class="col-md-6">
                        <small class="text-muted d-block fw-semibold text-uppercase" style="font-size:0.75rem;">Last Modified</small>
                        <span class="fs-6 text-dark">
                            @(Model.UpdatedDate.HasValue ? $"{Model.UpdatedDate.Value.ToLocalTime():g} by {Model.UpdatedBy}" : "Initial Seed")
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
